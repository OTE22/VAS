# =====================================================
# Face Recognition Service — environment template
# =====================================================
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# Generate every secret below with a CSPRNG. Do not reuse values between
# environments, and do not paste generated secrets back into this file.
#
#   JWT secret (48+ chars):   openssl rand -base64 48
#   Bootstrap admin password: openssl rand -base64 24
#
# Anything that ends up INSIDE a connection URL must be URL-safe. Use hex:
#   Database passwords:       openssl rand -hex 24
#   Redis password:           openssl rand -hex 24
#
# base64 emits '/', '+' and '='. A '/' in a password silently changes how the
# URL parses — in redis://fr_app:aB3/xY9@redis:6379/0 the host becomes "fr_app"
# and the password is lost, so the service connects nowhere.
#
# Easiest path: bash scripts/setup/generate-secrets.sh
#
# In production prefer Docker secrets over inline values. Every *_FILE variable
# below takes precedence over its inline counterpart and is read from disk, so
# the secret never appears in `docker inspect`, compose files, or process
# environment listings.

# =====================================================
# Environment
# =====================================================
# production | development
# production activates the fail-closed configuration preflight: startup aborts
# with exit code 78 if any secret below is missing, default, or weak.
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Must stay 1 until process-local state is externalized to Redis/Postgres.
# See backend/core/runtime_settings.py — raising this silently breaks admin
# settings propagation, SQL-agent cancellation, and single-flight job guards.
WORKERS=1

USE_GPU=false
# Set false on real GPU deployments so a missing CUDA provider fails startup
# instead of silently running inference on the CPU.
ALLOW_CPU_FALLBACK=true

LOG_DIR=/var/log/face-recognition
LOG_LEVEL=INFO

# =====================================================
# Authentication — REQUIRED, no safe default exists
# =====================================================
# openssl rand -base64 48
# Rotating this invalidates every issued token. That is intended.
JWT_SECRET_KEY=
# JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=face-recognition-service
JWT_AUDIENCE=face-recognition-api

# -----------------------------------------------------
# Pipeline ingest authentication — REQUIRED in production
# -----------------------------------------------------
# The webhook accepts frames that become identities, embeddings and stored face
# images. Without a key, anyone who can reach the port can create people and
# fill storage; nginx rate-limits the endpoint but does not authenticate it.
#
#   openssl rand -base64 48
#
# Comma-separated, because it is a SET. That is the rotation story: append the
# new key, roll it out to the cameras, then remove the old one — no window
# where either is rejected. Cameras send it as `X-Webhook-Key: <key>` or
# `Authorization: Bearer <key>`. Never as a query parameter: nginx, gunicorn
# and the access log all record the request line.
WEBHOOK_API_KEYS=
# WEBHOOK_API_KEYS_FILE=/run/secrets/webhook_api_keys
#
# Bearer token for an EXTERNAL sender — a third-party system that presents
#   Authorization: Bearer <token>
# An alias, not a second credential store: this value is appended to
# WEBHOOK_API_KEYS when settings are built, so rotation, redaction and the
# weak/reused/published checks all apply to it unchanged. Set either variable;
# setting both simply gives you two valid credentials.
# Consequence: startup violations name it positionally under WEBHOOK_API_KEYS
# (e.g. "Ingest key #2 is guessable"), not as WEBHOOK_AUTH_TOKEN.
WEBHOOK_AUTH_TOKEN=
# WEBHOOK_AUTH_TOKEN_FILE=/run/secrets/webhook_auth_token
# enforce | log_only | off.
# `log_only` checks the credential, logs what it WOULD reject, and lets the
# request through — for migrating an already-deployed fleet. Watch
# fr_webhook_auth_total{result="would_reject"} fall to zero, then set enforce.
#
# In production:
#   enforce   — required, and the only destination.
#   log_only  — permitted ONLY with WEBHOOK_AUTH_INSECURE_ACK=true. Keys are
#               still required and still verified; a bad one is logged and
#               accepted. Migration posture, warned about on every boot.
#   off       — REFUSED. Startup exits 78 no matter what is acknowledged, and a
#               missing key is reported even in this mode. There is no rollout
#               that `off` serves and `log_only` does not.
WEBHOOK_AUTH_MODE=enforce
# Some camera firmware can only send one fixed custom header name. Set this to
# whatever fixed header the sender can produce (e.g. X-API-Key).
# `Authorization: Bearer <token>` is ALWAYS accepted regardless of this value.
WEBHOOK_AUTH_HEADER=X-Webhook-Key
# Covers `log_only` only. It can no longer authorize `off` in production.
WEBHOOK_AUTH_INSECURE_ACK=false
# Issued credentials (Admin > Ingest Credentials) are cached in each worker for
# this long. THIS IS THE REVOCATION LATENCY: deleting a credential takes effect
# on every worker within this window, and a frame presented inside it may still
# be accepted. For immediate revocation, rotate the env key above and restart.
WEBHOOK_CREDENTIAL_CACHE_TTL_SECONDS=30

# Requires HTTPS. Enables the Secure flag and the __Host- cookie prefix.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_HOST_PREFIX=true

# Origins allowed to submit credentials. Required in production.
# e.g. https://face-detector.internal
AUTH_ALLOWED_ORIGINS=
AUTH_TRUST_PROXY_HEADERS=true
AUTH_RATE_LIMIT_ENABLED=true

# =====================================================
# Bootstrap administrator
# =====================================================
# Used ONCE, only when no admin account exists yet. The created account is
# forced to change its password on first login. The value is never logged.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
BOOTSTRAP_ADMIN_REQUIRE_ROTATION=true

# =====================================================
# PostgreSQL
# =====================================================
# The application must NOT connect as the postgres superuser in production.
# Create dedicated roles first: psql -f db/roles.sql
DATABASE_URL=postgresql+asyncpg://fr_app:CHANGE_ME@postgres:5432/face_recognition
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=face_recognition
POSTGRES_USER=fr_app
POSTGRES_PASSWORD=
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=60
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Passwords for the roles created by db/roles.sql. These are consumed by
# docker-compose (interpolation), not by the application: compose builds
# DATABASE_URL and the per-service credentials from them. The gpu and prod
# stacks declare them `${VAR:?}`, so a missing one aborts `docker compose up`
# with an error naming the variable.
#
#   openssl rand -hex 24        (hex: safe inside a connection URL)
#
# FR_APP_PASSWORD is the application's own role — the one that ends up in
# DATABASE_URL and POSTGRES_PASSWORD.
FR_APP_PASSWORD=
FR_MIGRATOR_PASSWORD=
FR_READONLY_PASSWORD=
FR_BACKUP_PASSWORD=

# The postgres superuser, used only to create the roles above and to run
# initdb. The application never connects with it, and config_guard refuses to
# start in production if it finds it in DATABASE_URL.
POSTGRES_SUPERUSER_PASSWORD=

# =====================================================
# Public origin (compose interpolation only)
# =====================================================
# The externally reachable origin, scheme included. Compose expands it into
# CORS_ORIGINS and AUTH_ALLOWED_ORIGINS for the gpu and prod stacks; the
# application itself never reads PUBLIC_ORIGIN. One value, so the two cannot
# drift apart and lock the UI out of its own API.
#   e.g. https://face-detector.internal
PUBLIC_ORIGIN=

# Grafana admin password (prod stack's monitoring UI; not an app setting).
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ROOT_URL=http://localhost:3000

# =====================================================
# Redis
# =====================================================
# Redis holds sessions, login rate-limit counters and the token revocation
# denylist. It must require authentication in any non-loopback deployment.
REDIS_URL=redis://fr_app:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_SIZE=25
CACHE_TTL=3600

# =====================================================
# Migrations
# =====================================================
# run    — apply `alembic upgrade head` (dev, and the one-shot migrate job)
# verify — check the revision only; a mismatch is fatal (API replicas)
# skip   — do nothing (workers, when the entrypoint already verified)
MIGRATIONS_MODE=run
# A failed migration step, or a schema not at the code's Alembic head, always
# aborts startup — in every environment. (The former MIGRATIONS_FAIL_CLOSED
# flag, which permitted a boot after a failed step, was removed.)
# Pin the expected head so a drifted schema cannot serve traffic.
MIGRATIONS_EXPECTED_HEAD=

# =====================================================
# API surface
# =====================================================
# /docs, /redoc and /openapi.json. Must be false in production.
ENABLE_API_DOCS=true
# Explicit origins only. A wildcard here disables credentialed CORS.
CORS_ORIGINS=http://localhost:8000

# =====================================================
# Models and storage
# =====================================================
DETECTION_MODEL=/app/weights/det_10g.onnx
RECOGNITION_MODEL=/app/weights/w600k_r50.onnx
SIMILARITY_THRESHOLD=0.4
CONFIDENCE_THRESHOLD=0.5
STORAGE_DIR=/app/storage
VECTOR_BACKEND=pgvector
SAVE_IMAGES=true
DATA_RETENTION_DAYS=30

# =====================================================
# Ollama / SQL agent
# =====================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_SQL_MODEL=hf.co/mradermacher/Arctic-Text2SQL-R1-7B-GGUF:Q4_K_M
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=120
CHROMADB_PATH=/app/sql_agent/chromadb_data
CHROMA_COLLECTION_NAME=sql_knowledge_base


# =====================================================
# Risk platform (unified risk engine, assessments, rate limits)
# =====================================================
# Business-hour timezone fallback (IANA name). Timestamps are STORED in UTC;
# this only affects local-time interpretation (off-hours, anomaly buckets).
# Per-pipeline override: pipelines.timezone column.
DEFAULT_SITE_TIMEZONE=UTC
# Weekend days, Monday=0 (Sat/Sun = 5,6)
WEEKEND_DAYS=5,6
# Site holidays for anomaly context (ISO dates, comma-separated)
ANOMALY_HOLIDAYS=
# Rolling anomaly-baseline horizon (days)
ANOMALY_BASELINE_MAX_DAYS=365
# Assessments for the same subject within this window dedup onto one row
ASSESSMENT_DEDUP_WINDOW_MINUTES=5
# Learned-threshold candidates below this sample count cannot be activated
THRESHOLD_MIN_SAMPLES_FOR_ACTIVATION=10
# Rate limiting (Redis-backed; per-user AND per-IP counters per scope).
# When Redis is unavailable the limiter FAILS OPEN with an approximate
# in-memory per-worker fallback and logs a warning.
API_RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_HEAVY_PER_MINUTE=60
# Multi-worker note: WORKERS>1 requires Redis for cross-worker single-flight
# (intelligence jobs, assessments); without Redis a startup warning is logged
# and single-flight is only guaranteed within each worker.


# =====================================================
# ML pipeline (first release: rules stay the production decision system)
# =====================================================
# rules (default, production-safe) | shadow (needs an approved anomaly model)
# hybrid / ml are GATED this release — activation returns the unmet gates.
ML_DECISION_MODE=rules
ML_INFERENCE_TIMEOUT_MS=1500
ML_SHADOW_TIMEOUT_MS=3000
ML_MODEL_CACHE_TTL_SECONDS=60
# Supervised training refuses (structured reason) below these reviewed-label floors
ML_SUPERVISED_MIN_LABELS=100
ML_SUPERVISED_MIN_PER_CLASS=25
ML_COLLECTOR_LATE_GRACE_MINUTES=120
# 0.0 = full feature vectors are NOT stored on predictions (privacy default).
# Raising this requires a documented privacy/retention/audit justification.
ML_FEATURE_SAMPLED_FULL_VECTOR_RATE=0.0
# Graph features stay unavailable (with recorded reason) below these floors
ML_GRAPH_MIN_NODES=25
ML_GRAPH_MIN_EDGES=50
ML_GRAPH_MIN_OBSERVATION_DAYS=14
ML_GRAPH_MIN_PAIR_APPEARANCES=3
ML_DRIFT_CHECK_INTERVAL_HOURS=24
ML_DRIFT_MIN_SAMPLES=200
ML_DRIFT_PSI_WARNING=0.1
ML_DRIFT_PSI_CRITICAL=0.25
ML_PREDICTION_RETENTION_DAYS=180
ML_SNAPSHOT_RETENTION_DAYS=365
ML_DRIFT_REPORT_RETENTION_DAYS=365
ML_ARTIFACT_DIR=models/ml
ML_MAX_ARTIFACT_MB=200
# =====================================================
# SQL AGENT — BOUNDED REASONING
# =====================================================
# What the agent may do AFTER an action, when it went wrong. Three separate
# budgets, deliberately: a dropped database connection is not a reasoning
# failure, and must not spend the turn's ability to correct itself.
#
# Every one of these is read by the graph's ROUTING functions, so they are
# what guarantees the loop terminates — not model behaviour. Raising them
# raises worst-case turn latency roughly linearly.
#
# Left unset, the conservative code defaults apply (3 / 1 / 1). The
# development stack raises them in docker-compose.cpu.yml because it runs on
# a fast remote model; production keeps the defaults, where every extra step
# is a local-model call measured in tens of seconds.

# Tool look-ups and re-plans share this budget for one turn.
SQL_AGENT_MAX_REASONING_STEPS=3

# Corrective re-plans. Each needs a listed trigger from the error taxonomy —
# there is no "just try again" path. 0 disables re-planning entirely: an
# invalid query then becomes an honest failure instead of a correction, and
# is still never executed.
SQL_AGENT_MAX_REPLANS=1

# Retries of the SAME SQL after a TRANSIENT database error (connection reset,
# pool timeout). No model call, so this does not consume reasoning.
SQL_AGENT_MAX_EXECUTION_RETRIES=1

# Optional integrations: flags only — the app runs fully in rules mode when the
# package is not installed (statuses reported: configured / implemented /
# dependency available / operational).
MLFLOW_ENABLED=false
OPTUNA_ENABLED=false
XGBOOST_ENABLED=false
SHAP_ENABLED=false
