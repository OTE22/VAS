# =====================================================
# Production Dockerfile (GPU) — Face Recognition Service
# =====================================================
# Requires:
#   - NVIDIA GPU with drivers installed
#   - NVIDIA Container Toolkit (nvidia-container-toolkit)
#   - Docker with GPU support enabled
#
# Base Image: Official NVIDIA CUDA image
# Registry: https://hub.docker.com/r/nvidia/cuda
#
# CUDA 12.4 + cuDNN 9, matched to the onnxruntime-gpu pin in
# requirements-gpu.txt. These two MUST move together.
#
# The version number lives in that file ONLY — deliberately not repeated here,
# not even in a comment, so there is nothing to update in two places and no
# stale number to mislead. tests/test_gpu_runtime.py enforces that.
#
# The previous pairing was CUDA 11.8 with an unpinned `onnxruntime-gpu>=1.16.3`.
# pip resolved that to a CUDA 12 wheel, whose CUDA libraries were absent from
# the 11.8 image, so ONNX Runtime dropped CUDAExecutionProvider from its
# provider list and ran on the CPU. Nothing failed loudly: results were correct,
# logs were clean, the healthcheck passed, and the GPU sat idle.
#
# Requires an NVIDIA driver >= 525 on the host. Verify before deploying:
#   nvidia-smi --query-gpu=driver_version --format=csv

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS base

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install Python 3.11 — from deadsnakes, NOT from jammy.
#
# Ubuntu 22.04 never shipped a final CPython 3.11: `apt-cache policy python3.11`
# on this base returns 3.11.0~rc1-1~22.04.1, a RELEASE CANDIDATE. That RC is
# missing sys.get_int_max_str_digits (added in 3.11.0 final), which torch's
# _dynamo polyfill references at import time. The result was a three-layer
# masked failure in production:
#
#     sentence_transformers -> "Could not import PreTrainedModel"
#     transformers          -> AttributeError
#     torch/_dynamo         -> sys.get_int_max_str_digits   <- the real cause
#
# Every SQL-agent query then logged "no embedding produced - semantic query
# search degraded" while the rest of the app looked healthy. The CPU image
# never had this: it builds FROM python:3.11-slim and gets 3.11.16.
#
# deadsnakes provides 3.11.15 for jammy, which brings this image in line.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3.11-distutils \
        python3-pip \
    && python3.11 -c "import sys; assert hasattr(sys, 'get_int_max_str_digits'), \
        f'got Python {sys.version.split()[0]} - not a final 3.11 release'" \
    && rm -rf /var/lib/apt/lists/*

# Create symlinks for python and pip
# -f: the CUDA/Ubuntu 22.04 base already ships a /usr/bin/python3 symlink, so a
# plain `ln -s` fails with "File exists" and the whole build dies at step 2.
RUN ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3

# =====================================================
# System dependencies (runtime only)
# =====================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1 \
    postgresql-client \
    redis-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install gosu separately to ensure it works
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends gosu; \
    rm -rf /var/lib/apt/lists/*; \
    gosu nobody true

WORKDIR /app

# =====================================================
# Python dependencies (GPU version)
# =====================================================
# Copied under their real names. This used to be
# `COPY requirements-gpu.txt requirements.txt`, i.e. a RENAME, which is why a
# /app/requirements.txt appeared to exist at runtime while no such file exists
# in the repository — and why Docs/01_QUICK_START.md's
# `pip install -r requirements.txt` looked plausible but could never work.
#
# requirements-base.txt is REQUIRED: requirements-gpu.txt starts with
# `-r requirements-base.txt`, resolved relative to the file, so the build fails
# immediately without it.
COPY requirements-base.txt requirements-gpu.txt requirements-dev.txt requirements-ml.txt ./
# BuildKit cache mount — same rationale as Dockerfile.cpu: wheel downloads
# survive cache busts and killed builds; image content is unchanged.
# blinker: the CUDA/Ubuntu base ships python3-blinker 1.4 as a distutils
# package in /usr/lib/python3/dist-packages, which pip cannot uninstall
# ("uninstall-distutils-installed-package"). mlflow -> Flask needs >= 1.9.
# --ignore-installed puts the new one in /usr/local, earlier on sys.path, and
# the requirements install then sees it as satisfied. python:3.11-slim (the
# CPU image) has no system blinker, which is why Dockerfile.cpu never hit this.
RUN --mount=type=cache,target=/root/.cache/pip \
    env -u PIP_NO_CACHE_DIR pip install --upgrade pip && \
    env -u PIP_NO_CACHE_DIR pip install --ignore-installed "blinker>=1.9" && \
    env -u PIP_NO_CACHE_DIR pip install -r requirements-gpu.txt

# ---------------------------------------------------------------------------
# Force the CUDA ONNX Runtime to be the one on disk.
#
# `chromadb` HARD-DEPENDS on `onnxruntime` — the CPU build — because its default
# embedding function runs ONNXMiniLM on it, and sql_agent/knowledge_base.py
# creates its collection without passing an embedding_function. So this image
# installs onnxruntime-gpu (requested) AND onnxruntime (dragged in by chromadb).
#
# Both distributions unpack into the SAME `onnxruntime/` package directory, so
# with both present the build that actually loads is decided by installation
# order — the identical hazard this repo already fixed for OpenCV, where
# headless 4.9.0.80 was pinned while contrib 4.11.0.86 shadowed it. Losing that
# race here means CUDAExecutionProvider is simply absent and every SCRFD/ArcFace
# inference runs on the CPU, with correct results, clean logs and a passing
# healthcheck — the exact silent-fallback failure the pinned CUDA version above
# exists to prevent.
#
# Removing the CPU build alone is not enough: `pip uninstall onnxruntime`
# deletes files that onnxruntime-gpu also owns, so the GPU build is reinstalled
# afterwards to restore them. --no-deps keeps that reinstall from pulling the
# CPU package straight back in through chromadb.
#
# chromadb's requirement is then unsatisfied in pip's metadata, so `pip check`
# reports it. That is cosmetic and expected: onnxruntime-gpu provides the same
# `onnxruntime` module that chromadb imports.
# tests/test_gpu_runtime.py asserts this step stays here.
# The version is READ BACK from requirements-gpu.txt rather than repeated here.
# A second copy of the number in this file is a second thing to forget: the pin
# and the reinstall would drift, and the reinstall silently wins.
RUN --mount=type=cache,target=/root/.cache/pip \
    ORT_GPU="$(grep -E '^onnxruntime-gpu==' requirements-gpu.txt)" && \
    test -n "$ORT_GPU" && echo "Pinned CUDA runtime: $ORT_GPU" && \
    if pip show onnxruntime >/dev/null 2>&1; then \
        echo "Removing the CPU onnxruntime that chromadb pulled in"; \
        pip uninstall -y onnxruntime; \
        env -u PIP_NO_CACHE_DIR pip install --no-deps --force-reinstall "$ORT_GPU"; \
    fi && \
    python -c "from importlib.metadata import distributions; \
names = {d.metadata['Name'].lower() for d in distributions()}; \
print('onnxruntime distributions present:', sorted(n for n in names if 'onnxruntime' in n)); \
assert 'onnxruntime-gpu' in names, 'the CUDA ONNX Runtime is not installed'; \
assert 'onnxruntime' not in names, \
    'the CPU onnxruntime is still installed alongside onnxruntime-gpu'"

# Test dependencies — development / CI image only, mirroring Dockerfile.cpu.
# The GPU image had no INSTALL_DEV at all, so it could not run the suite that
# verifies GPU behaviour — the one place those tests actually mean something.
ARG INSTALL_DEV=false
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$INSTALL_DEV" = "true" ]; then \
        env -u PIP_NO_CACHE_DIR pip install -r requirements-dev.txt; \
    fi

# =====================================================
# Application code
# =====================================================
COPY . .

# =====================================================
# Runtime directories & permissions
# =====================================================
RUN mkdir -p \
    /tmp \
    /app/storage \
    /app/weights \
    /app/storage/faces \
    /app/storage/faces/.incoming \
    /app/storage/pending \
    /app/storage/debug/webhook_images \
    /app/storage/debug/cropped \
    /var/log/face-recognition \
    /app/logs \
    /app/models/ml/candidates \
    /app/models/ml/datasets \
    && chmod 1777 /tmp

# =====================================================
# Non-root user (security)
# =====================================================
# The model-cache tree is created HERE, while this stage is still root.
#
# docker-compose pins `user: "1000:1000"`, so the entrypoint runs unprivileged
# and cannot chown anything. And when a volume is mounted at
# /home/appuser/.cache/chroma, Docker creates the MISSING parent
# /home/appuser/.cache itself, as root, before the entrypoint runs — leaving
# appuser unable to create /home/appuser/.cache/huggingface. SentenceTransformer
# then raised PermissionError and the chatbot's semantic query-history search
# was silently disabled. Creating the parent in the image means Docker finds it
# already present and leaves its ownership alone.
RUN useradd -m -u 1000 -s /bin/bash appuser \
    && chown -R appuser:appuser /app /var/log/face-recognition \
    && mkdir -p /home/appuser/.cache/huggingface \
                /home/appuser/.cache/chroma/onnx_models \
    && chown -R appuser:appuser /home/appuser/.cache \
    && chmod -R 775 /home/appuser/.cache

# Copy entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Start as root to fix permissions, then switch to appuser
USER root
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# =====================================================
# Networking
# =====================================================
EXPOSE 8000

# =====================================================
# Healthcheck
# =====================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fs http://localhost:8000/health || exit 1

# =====================================================
# Entrypoint
# =====================================================
CMD ["gunicorn", "backend.main:app", "-c", "gunicorn.conf.py"]

