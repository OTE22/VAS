# FACE_DETECTOR - PRODUCTION (air-gapped) deployment settings
# ---------------------------------------------------------------------------
# Copy to docker/.env on the production host. No secrets here: JWT, database
# and LLM credentials come from Docker secrets (see docker-compose.prod.yml).
# The config guard refuses the boot (exit 78) when any line below points off
# the box; /health/offline-policy (admin) shows the [PASS]/[FAIL] checklist.

# Environment
ENVIRONMENT=production
OFFLINE_MODE=true

# Inference - local only. Ollama (default) or an OpenAI-compatible local server.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# The two models the model manifest lists (deploy.sh model-manifest) and
# the offline bundle carries; deploy.sh stage 13 checks `ollama list` for them.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_SQL_MODEL=hf.co/mradermacher/Arctic-Text2SQL-R1-7B-GGUF:Q4_K_M
# vLLM / local NIM alternative (uncomment; start the `vllm` compose profile):
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# LLM_SQL_MODEL=
LLM_DEV_PROVIDER=
NVIDIA_NIM_API_KEY=

# Embeddings - the bundled ONNX MiniLM, verified at boot
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_PATH=/home/appuser/.cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx/model.onnx

# Vector store - embedded Chroma (default) or the `milvus` compose profile
VECTOR_STORE=chroma
MILVUS_URI=

# MCP - in-process tools; set only when the `mcp-sql` profile runs
MCP_SQL_URL=
AGENT_ORCHESTRATOR=langgraph

# Voice - local only (none until a local STT is bundled)
STT_PROVIDER=none
STT_BASE_URL=
STT_MODEL_PATH=

# Telemetry - local Prometheus/Grafana only; OTLP only to a local collector
OTEL_EXPORTER_ENDPOINT=
SQL_AGENT_OPIK_ENABLED=false

# Production safety
ALLOW_EXTERNAL_APIS=false
ALLOW_MODEL_DOWNLOADS=false
ALLOW_EXTERNAL_TELEMETRY=false
# The manifest is verified on the HOST by scripts/verify_offline_bundle.sh.
# This path is checked inside the API container, so set it only when the
# bundle directory is also mounted there; empty = not checked at boot.
OFFLINE_BUNDLE_MANIFEST=

# Model libraries must never try the hub
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
